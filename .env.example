# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartsell

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_TTS_API_KEY=your-azure-tts-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# OpenAI (optional - only if using OpenAI instead of Azure)
# Voice feature uses browser Web Speech API (no key needed)
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# TTS Service (optional override)
# TTS_BASE_URL=https://ai-tts.treppanliving.ae
